<?xml version="1.0" encoding="utf-8"?>
<!--
  crocwork Material MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build materialcraft.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files, a Start Menu shortcut, `.mcraft` owned by crocwork Material,
  and crocwork Material offered under "Open with" for the mesh formats it opens (without taking over
  the user's default app for them).

  UpgradeCode is crocwork Material's for good: generated once (2026-10-14), never change it, or new
  versions install beside old ones instead of replacing them.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="crocwork Material"
      Manufacturer="crocwork"
      Version="$(var.Version)"
      UpgradeCode="C1BC4DB3-A05D-54C8-B3A4-48DB02880566"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="crocwork Material procedural material designer" Manufacturer="crocwork" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of crocwork Material is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- MSI caches this icon using its Id as the filename. Advertised shortcuts to an
         .exe need an .exe icon identifier (ICE50), even when the source is an ICO. -->
    <Icon Id="MaterialCraftIcon.exe" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="MaterialCraftIcon.exe" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/CROC101/crocwork-material" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/CROC101/crocwork-material" />
    <Property Id="ARPHELPLINK" Value="https://github.com/CROC101/crocwork-material" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="crocwork Material" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="crocwork Material" Level="1">
      <ComponentGroupRef Id="MaterialCraftFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="MaterialCraftFiles" Directory="INSTALLFOLDER">
      <Component Id="MaterialCraftApp">
        <File Id="MaterialCraftExe" Source="$(var.BinDir)\materialcraft.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="crocwork Material"
              Description="crocwork Material procedural material designer" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="MaterialCraftIcon.exe" IconIndex="0" />
        </File>

        <!-- .mcraft: crocwork Material's own package format; crocwork Material is its default app. -->
        <ProgId Id="crocwork Material.Package" Description="crocwork Material Package" Icon="MaterialCraftExe" IconIndex="0">
          <Extension Id="mcraft" ContentType="application/x-materialcraft">
            <Verb Id="open" Command="Open" TargetFile="MaterialCraftExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>

        <!-- "Open with" app list and the Run dialog (Win+R "materialcraft"). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\materialcraft.exe" Name="FriendlyAppName" Value="crocwork Material" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\materialcraft.exe\shell\open\command" Value="&quot;[#MaterialCraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\materialcraft.exe\SupportedTypes" Name=".mcraft" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\materialcraft.exe" Value="[#MaterialCraftExe]" Type="string" />
      </Component>

      <Component Id="MaterialCraftCli">
        <File Id="MaterialCraftCliExe" Source="$(var.BinDir)\materialcraft-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
